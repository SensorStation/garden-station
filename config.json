{
    "station": "garden-station",
    "devices": {
        "soil": {
            "type": "vh400",
            "bus": "/dev/i2c-1",
            "addr": "0x48",
            "channel": 0,
            "interval": 10
        },
        "pump": {
            "type": "relay",
            "chip": "gpiochip0",
            "offset": 5
        },
        "light": {
            "type": "relay",
            "chip": "gpiochip0",
            "offset": 16
        },
        "on": {
            "type": "button",
            "chip": "gpiochip0",
            "offset": 17
        },
        "off": {
            "type": "button",
            "chip": "gpiochip0",
            "offset": 27
        },
        "temperature": {
            "type": "bme280",
            "bus": "/dev/i2c-1",
            "addr": "0x76",
            "interval": 10
        },
        "display": {
            "type": "oled",
            "bus": "1",
            "addr": "0x27",
            "height": 64,
            "width": 128
        }
    }
}
